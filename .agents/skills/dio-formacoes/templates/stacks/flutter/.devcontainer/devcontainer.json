{
  "name": "DIO - Flutter",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "editorconfig.editorconfig"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "flutter --version && flutter config --enable-web --no-analytics",
  "remoteUser": "root"
}
